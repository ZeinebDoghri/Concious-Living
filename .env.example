# ─────────────────────────────────────────────────────────────
# ORKA — Conscious Living — Environment Variables Template
# ─────────────────────────────────────────────────────────────
# Copy this file and rename it to: lib/config/api_keys.dart
# Then fill in your own API keys.
# NEVER commit the real api_keys.dart file to GitHub.
# ─────────────────────────────────────────────────────────────

# Format attendu dans lib/config/api_keys.dart :
#
# const String geminiApiKey = 'YOUR_GEMINI_KEY_1_HERE';
# const List<String> geminiApiKeys = [
#   'YOUR_GEMINI_KEY_1_HERE',
#   'YOUR_GEMINI_KEY_2_HERE',
#   'YOUR_GEMINI_KEY_3_HERE',
#   'YOUR_GEMINI_KEY_4_HERE',
#   'YOUR_GEMINI_KEY_5_HERE',
# ];
# const String googlePlacesApiKey = 'YOUR_GOOGLE_PLACES_KEY_HERE';
# const String openWeatherApiKey  = 'YOUR_OPENWEATHER_KEY_HERE';

# ─── Google Gemini API ────────────────────────────────────────
# Obtenir sur : https://aistudio.google.com/app/apikey
# 5 clés recommandées pour la rotation automatique (évite les limites de taux)
GEMINI_API_KEY_1=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_API_KEY_3=your_gemini_api_key_3_here
GEMINI_API_KEY_4=your_gemini_api_key_4_here
GEMINI_API_KEY_5=your_gemini_api_key_5_here

# ─── Google Places API ────────────────────────────────────────
# Obtenir sur : https://console.cloud.google.com → APIs & Services
# Activer : Places API (New)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# ─── OpenWeatherMap API ───────────────────────────────────────
# Obtenir sur : https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ─── Cloudinary ───────────────────────────────────────────────
# Obtenir sur : https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# ─── Firebase ─────────────────────────────────────────────────
# Fichiers à obtenir depuis Firebase Console :
# - android/app/google-services.json
# - ios/Runner/GoogleService-Info.plist
# Ces fichiers sont déjà exclus du dépôt via .gitignore
